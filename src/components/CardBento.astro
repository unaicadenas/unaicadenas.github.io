---
const { className, title } = Astro.props;
---

<div class={`${className ?? ""} border rounded-2xl px-8 pt-5 pb-8 backdrop-blur-sm transition-all duration-300 flex flex-col justify-between min-h-40 shadow-md
            bg-[#12a66a14] border-[#10161318]`}>
    <div>
        <h3 class="text-3xl font-semibold text-(--primary-color) dark:text-(--primary-color-dark) mb-3">&gt; {title}</h3>
    </div>
    <div class="flex flex-wrap gap-4 text-4xl text-gray-300">
        <slot />
    </div>
</div>

---
import Layout from '@/layouts/Layout.astro';

import SectionContainer from "@/components/SectionContainer.astro";
import TitleSection from "@/components/TitleSection.astro";

import Header from "@/sections/Header.astro";
import AboutMe from "@/sections/AboutMe.astro";
import Experience from "@/sections/Experience.astro";
import Projects from "@/sections/Projects.astro";
import Stack from "@/sections/Stack.astro";
import Contact from "@/sections/Contact.astro";

import { ui, type Lang } from '@/i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Layout lang={lang} title={t.SEO.title}>

	<main class="px-4 mb-30">

		<SectionContainer>
			<Header lang={lang} />
		</SectionContainer>

		<div class="space-y-30 mt-24">

			<!-- Sobre mi -->
			<SectionContainer id="sobre-mi">
				<TitleSection>{t.about.title}</TitleSection>
				<AboutMe lang={lang} />
			</SectionContainer>

			<!-- Experiencia laboral -->
			<SectionContainer id="experiencia">
				<TitleSection>{t.experience.title}</TitleSection>
				<Experience lang={lang} />
			</SectionContainer>

			<!-- Proyectos -->
			<!--
			<SectionContainer id="proyectos">
				<TitleSection>Proyectos</TitleSection>
				<Projects />
			</SectionContainer>
			-->

			<!-- Stack Tecnologico -->
			<SectionContainer id="stack">
				<TitleSection>{t.stack.title}</TitleSection>
				<Stack lang={lang} />
			</SectionContainer>

			<!-- Contacto -->
			<SectionContainer id="contacto">
				<TitleSection>{t.contact.title}</TitleSection>
				<Contact lang={lang} />
			</SectionContainer>

		</div>

	</main>

</Layout>

---
import CardBento from "@/components/CardBento.astro";

import { ui, type Lang } from '@/i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

<div class="grid grid-cols-1 md:grid-cols-6 gap-4">

	<!-- FRONTEND -->
	<CardBento className="md:col-span-3" title={t.stack.card1}>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-html5-plain colored text-2xl" title="HTML5"></i>
			<span class="text-sm font-semibold text-gray-600">HTML</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-css3-plain colored text-2xl" title="CSS3"></i>
			<span class="text-sm font-semibold text-gray-600">CSS</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-javascript-plain colored text-2xl" title="JavaScript"></i>
			<span class="text-sm font-semibold text-gray-600">JavaScript</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-typescript-plain colored text-2xl" title="TypeScript"></i>
			<span class="text-sm font-semibold text-gray-600">TypeScript</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-react-original colored text-2xl" title="React"></i>
			<span class="text-sm font-semibold text-gray-600">React</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-astro-plain colored text-2xl" title="Astro"></i>
			<span class="text-sm font-semibold text-gray-600">Astro</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-tailwindcss-plain colored text-2xl" title="Tailwind CSS"></i>
			<span class="text-sm font-semibold text-gray-600">Tailwind</span>
		</a>
	</CardBento>

	<!-- BACKEND -->
	<CardBento className="md:col-span-3" title={t.stack.card2}>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-nodejs-plain colored text-2xl" title="Node.js"></i>
			<span class="text-sm font-semibold text-gray-600">Node.js</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-python-plain colored text-2xl" title="Python"></i>
			<span class="text-sm font-semibold text-gray-600">Python</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-java-plain colored text-2xl" title="Java"></i>
			<span class="text-sm font-semibold text-gray-600">Java</span>
		</a>
	</CardBento>

	<!-- DATABASE -->
	<CardBento className="md:col-span-2" title={t.stack.card3}>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-mysql-plain colored text-2xl" title="MySQL"></i>
			<span class="text-sm font-semibold text-gray-600">MySQL</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-postgresql-plain colored text-2xl" title="PostgreSQL"></i>
			<span class="text-sm font-semibold text-gray-600">PostgreSQL</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-mongodb-plain colored text-2xl" title="MongoDB"></i>
			<span class="text-sm font-semibold text-gray-600">MongoDB</span>
		</a>
	</CardBento>

	<!-- TOOLS -->
	<CardBento className="md:col-span-2" title={t.stack.card4}>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-git-plain colored text-2xl" title="Git"></i>
			<span class="text-sm font-semibold text-gray-600">Git</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-github-original colored text-2xl" title="GitHub"></i>
			<span class="text-sm font-semibold text-gray-600">GitHub</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-docker-plain colored text-2xl" title="Docker"></i>
			<span class="text-sm font-semibold text-gray-600">Docker</span>
		</a>
	</CardBento>

	<CardBento className="md:col-span-2" title={t.stack.card5}>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-photoshop-plain colored text-2xl" title="Photoshop"></i>
			<span class="text-sm font-semibold text-gray-600">Photoshop</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-canva-plain colored text-2xl" title="Canva"></i>
			<span class="text-sm font-semibold text-gray-600">Canva</span>
		</a>
		<a href="#" class="flex justify-center items-center px-3 py-1 border border-gray-600 rounded-full transition-transform hover:scale-110 gap-1">
			<i class="devicon-figma-plain colored text-2xl" title="Figma"></i>
			<span class="text-sm font-semibold text-gray-600">Figma</span>
		</a>
	</CardBento>

</div>

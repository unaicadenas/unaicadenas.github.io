---
import { ui, type Lang } from '@/i18n/ui';

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<div class="bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 backdrop-blur-sm shadow-md rounded-2xl px-5 py-8 md:px-20">
	<form>
		<div class="pb-4">
			<!-- Formulario -->
			<div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-6">
				<!-- Nombre -->
				<div class="sm:col-span-3">
					<label for="name" class="block text-sm/6 font-medium text-gray-900 dark:text-white">{t.contact.name}</label>
					<div class="mt-2">
						<input id="name" type="text" name="name" autocomplete="name"
							class="block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6
								bg-white dark:bg-white/5 text-gray-900 dark:text-white backdrop-blur-sm
								outline-1 -outline-offset-1 outline-gray-300 dark:outline-white/10
								focus:outline-2 focus:-outline-offset-2 focus:outline-(--primary-color) dark:focus:outline-(--primary-color-dark)"
						/>
					</div>
				</div>
				<!-- Email -->
				<div class="sm:col-span-3">
					<label for="email" class="block text-sm/6 font-medium text-gray-900 dark:text-white">{t.contact.email}</label>
					<div class="mt-2">
						<input id="email" type="email" name="email" autocomplete="email"
							class="block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6
								bg-white dark:bg-white/5 text-gray-900 dark:text-white backdrop-blur-sm
								outline-1 -outline-offset-1 outline-gray-300 dark:outline-white/10
								focus:outline-2 focus:-outline-offset-2 focus:outline-(--primary-color) dark:focus:outline-(--primary-color-dark)"
						/>
					</div>
				</div>
				<!-- Comentario -->
				<div class="col-span-full">
					<label for="about" class="block text-sm/6 font-medium text-gray-900 dark:text-white">{t.contact.comment}</label>
					<div class="mt-2">
						<textarea id="about" name="about" rows="4"
							class="block w-full rounded-md px-3 py-1.5 text-base sm:text-sm/6
								bg-white dark:bg-white/5 text-gray-900 dark:text-white backdrop-blur-sm
								outline-1 -outline-offset-1 outline-gray-300 dark:outline-white/10
								focus:outline-2 focus:-outline-offset-2 focus:outline-(--primary-color) dark:focus:outline-(--primary-color-dark)"
						></textarea>
					</div>
					<p class="mt-3 text-sm/6 text-gray-600 dark:text-gray-400">{t.contact.text}</p>
				</div>
			</div>
		</div>
		<div class="text-center">
			<button type="submit" class="rounded-full bg-(--primary-color) dark:bg-(--primary-color-dark) px-10 py-2 font-semibold text-slate-100 dark:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 hover:scale-110 transition duration-200 ease-in-out">{t.contact.button}</button>
		</div>
	</form>
</div>

---
import CardProject from "@/components/CardProject.astro";

type Proyecto = {
    title: string;
    description: string;
};

const Proyectos: Proyecto[] = [
    /*
    {
        title: "Portfolio personal",
        description:
            "Portfolio web desarrollado con Astro y Tailwind CSS, con diseño responsive, animaciones y soporte multilingüe en español, euskera e inglés.",
    },
    {
        title: "Dashboard de gestión",
        description:
            "Aplicación web para la gestión de cajeros automáticos, manuales, aplicaciones y turnos, con buscador, filtros y una interfaz responsive.",
    },
    */
];
---

<div class="flex flex-col md:flex-row gap-16 text-center items-center justify-center">
	{
        Proyectos.length > 0 ? (
            Proyectos.map((exp) => <CardProject {...exp} />)
        ) : (
            <div class="w-full py-16 bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-2xl shadow-lg">
                <h4 class="text-xl text-neutral-500 dark:text-slate-400">Todavía no tengo proyectos, proximamente...</h4>
            </div>
        )
	}
</div>

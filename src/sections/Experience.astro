---
import ExperienceSection from "@/components/ExperienceSection.astro";

import { ui, type Lang } from '@/i18n/ui';
interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const Experiencias = [
    {
        title: t.experience.card1.job,
        company: t.experience.card1.company,
        description: t.experience.card1.description,
        date: t.experience.card1.start + " - " + t.experience.card1.end,
        current: true,
    },
    {
        title: t.experience.card2.job,
        company: t.experience.card2.company,
        description: t.experience.card2.description,
        date: t.experience.card2.start + " - " + t.experience.card2.end,
    },
]
---

<div class="w-full max-w-4xl mx-auto">
    <ol class="relative border-s-2 border-gray-300 space-y-10">
        {
            Experiencias.map((exp, i) => (
                <li>
                    <ExperienceSection {...exp} />
                </li>
            ))
        }
    </ol>
</div>

---
import Layout from '@/layouts/Layout.astro';
---

<Layout lang="es" title="404 | Página no encontrada">
    <main class="h-full">
        <section class="h-full flex flex-col justify-center items-center text-center">
            <h1 class="text-8xl font-bold text-(--primary-color) dark:text-(--primary-color-dark) mb-4">404</h1>
            <h2 class="text-2xl font-semibold sm:text-6xl mb-8">¡Vaya! Te has perdido.</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-8">La página que buscas no existe o ya no está disponible.</p>
            <a
                href="/"
                class="inline-flex items-center gap-2 rounded-full border-2 border-(--primary-color) dark:border-(--primary-color-dark) text-(--primary-color) dark:text-(--primary-color-dark) px-6 py-3 font-medium shadow-lg transition hover:scale-105 hover:shadow-xl"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                </svg>
                <span>Volver al inicio</span>
            </a>
        </section>
    </main>
</Layout>

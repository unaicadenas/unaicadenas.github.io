---
import App from "@/app/App.astro";
import type { Lang } from "@/i18n/ui";

export function getStaticPaths() {
    return [
        { params: { lang: 'eu' } },
        { params: { lang: 'ca' } },
        { params: { lang: 'en' } },
    ];
}

const lang = Astro.params.lang as Lang;
---

<App lang={lang} />
